{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coredrone:contracts:warehouse_layout",
  "title": "WarehouseLayout",
  "description": "Schema for config/warehouses/<name>.yaml. One layout file drives the sim world generator, mission route generation, slot attribution and the sim ground truth. Coordinates are in the warehouse map frame: ENU, metres, z = 0 on the floor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "warehouse_id",
    "geodetic_origin",
    "takeoff",
    "rack_defaults",
    "labels",
    "slot_code_format",
    "scan",
    "aisles"
  ],
  "$defs": {
    "point2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "rack_geometry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bays": { "description": "Slot columns per level.", "type": "integer", "minimum": 1, "maximum": 100 },
        "bay_width_m": { "type": "number", "exclusiveMinimum": 0 },
        "depth_m": { "type": "number", "exclusiveMinimum": 0 },
        "level_heights_m": {
          "description": "Shelf deck heights above the floor, bottom to top.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "number", "minimum": 0 }
        },
        "height_m": { "description": "Upright height.", "type": "number", "exclusiveMinimum": 0 },
        "beam_height_m": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "rack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "side"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "side": {
          "description": "Side of the aisle centre line the rack is on, looking from start to end.",
          "enum": ["left", "right"]
        },
        "offset_m": {
          "description": "Distance along the aisle from its start to the rack's first bay edge.",
          "type": "number",
          "minimum": 0,
          "default": 0
        },
        "geometry": { "$ref": "#/$defs/rack_geometry" },
        "scan": {
          "description": "Set false to leave this rack face out of the route.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "aisle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "start", "end", "width_m", "racks"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "start": { "$ref": "#/$defs/point2", "description": "Entry end of the aisle centre line." },
        "end": { "$ref": "#/$defs/point2" },
        "width_m": { "description": "Clear width between the two rack faces.", "type": "number", "exclusiveMinimum": 0 },
        "racks": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/rack" } }
      }
    },
    "label_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "size_m"],
      "properties": {
        "kind": { "enum": ["apriltag", "qr"] },
        "family": { "description": "AprilTag family. Isaac ROS only supports tag36h11.", "enum": ["tag36h11"] },
        "size_m": { "description": "Edge length of the code itself, excluding the white quiet zone (AprilTag: black border square; QR: finder-pattern corners). Detectors use it for pose estimation.", "type": "number", "exclusiveMinimum": 0 },
        "first_id": { "description": "AprilTag IDs are assigned in slot order starting here.", "type": "integer", "minimum": 0 },
        "payload_format": { "description": "QR payload; fields: slot_code, sku.", "type": "string" }
      }
    }
  },
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "warehouse_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "maxLength": 64 },
    "name": { "type": "string" },
    "geodetic_origin": {
      "description": "Geodetic point of the map origin. Used as the ArduPilot EKF origin (no GPS indoors) and as SITL home.",
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude_deg", "longitude_deg", "altitude_m"],
      "properties": {
        "latitude_deg": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude_deg": { "type": "number", "minimum": -180, "maximum": 180 },
        "altitude_m": { "description": "Metres above mean sea level.", "type": "number" }
      }
    },
    "takeoff": {
      "description": "Takeoff and landing pad, normally at the end of an aisle.",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "yaw_deg": { "type": "number", "default": 0 }
      }
    },
    "rack_defaults": {
      "allOf": [{ "$ref": "#/$defs/rack_geometry" }],
      "required": ["bays", "bay_width_m", "depth_m", "level_heights_m", "height_m", "beam_height_m"]
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "item"],
      "properties": {
        "location": { "$ref": "#/$defs/label_spec", "description": "One location label per slot, on the beam below the slot." },
        "item": { "$ref": "#/$defs/label_spec", "description": "Label on the aisle-facing side of each item." }
      }
    },
    "slot_code_format": {
      "description": "Python format string for slot codes. Fields: aisle, rack, side, level, bay (0-based).",
      "type": "string",
      "minLength": 1
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standoff_m", "hover_s"],
      "properties": {
        "standoff_m": { "description": "Camera distance from the rack face at each hover point.", "type": "number", "exclusiveMinimum": 0 },
        "camera_height_offset_m": { "description": "Camera height above each shelf deck.", "type": "number", "default": 0.1 },
        "hover_s": { "description": "Dwell time at each hover point.", "type": "number", "minimum": 0 },
        "transit_altitude_m": { "type": "number", "exclusiveMinimum": 0, "default": 1.0 },
        "speed_mps": { "type": "number", "exclusiveMinimum": 0, "default": 0.5 },
        "order": { "enum": ["serpentine", "raster"], "default": "serpentine" }
      }
    },
    "aisles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/aisle" } },
    "sim": {
      "description": "Simulation only: what is on the shelves. Omit for real warehouses.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": { "type": "integer" },
        "fill_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "sku_format": { "type": "string" },
        "box_size_m": {
          "type": "array",
          "items": { "type": "number", "exclusiveMinimum": 0 },
          "minItems": 3,
          "maxItems": 3
        }
      }
    }
  }
}
