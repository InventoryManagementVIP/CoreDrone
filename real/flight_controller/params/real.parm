# Real-vehicle overrides for the parts in real/BOM.md, loaded after common.parm.
# UNVERIFIED: nothing here has run on hardware. Per-airframe tuning goes in a separate file, e.g.
# real/flight_controller/params/airframe_<name>.parm, generated by an autotune flight.

# ---- Ports (Pixhawk 6C: SERIAL1 = TELEM1, SERIAL2 = TELEM2, hwdef/Pixhawk6C) -----------------------
SERIAL1_PROTOCOL     2       # MAVLink2 to the SiK telemetry radio (ground station)
SERIAL1_BAUD         57      # the radio's default
SERIAL2_PROTOCOL     45      # DDS to the micro-ROS agent on the Jetson
SERIAL2_BAUD         921     # 921600; must match the agent's -b flag (real_platform.launch.py)
# Three-wire link: BRD_SER2_RTSCTS stays at its default (auto), which detects there is no flow control.
# USB (SERIAL0) stays MAVLink: the Jetson's mavlink-router and fc_bootstrap use it.

# ---- Arming ------------------------------------------------------------------------------------
BRD_SAFETY_DEFLT     0       # no safety button on the BOM (Holybro puts it on the GPS module)

# ---- Height: no rangefinder on the BOM, so EKF height comes from VSLAM ---------------------------
# Remove these two lines, and set RNGFND1_TYPE for the sensor, when a rangefinder is fitted.
EK3_SRC1_POSZ        6       # ExternalNav
RNGFND1_TYPE         0

# ---- EKF source set 2: no optical flow on the BOM, so there is no position fallback --------------
# If VSLAM is lost, FS_EKF_ACTION (common.parm) lands. Height falls back to the barometer.
EK3_SRC2_VELXY       0       # None
EK3_SRC2_POSZ        1       # Baro
EK3_SRC2_YAW         0       # None

# ---- Battery: PM02 on the board's default power-monitor pins (BATT_MONITOR 4, hwdef defaults) ----
# TODO(hardware): assumes 4S; confirm the delivered pack and adjust.
BATT_LOW_VOLT        14.0    # 3.5 V per cell under load
BATT_CRT_VOLT        13.6    # 3.4 V per cell
BATT_FS_LOW_ACT      1       # land
BATT_FS_CRT_ACT      1       # land

# ---- RC: safety pilot (mandatory for real flights). Not on the BOM yet --------------------------
# TODO(hardware): mode switch with LOITER/ALT_HOLD and a motor kill switch, e.g.:
# RC8_OPTION         31      # motor emergency stop
FS_THR_ENABLE        1       # radio failsafe on
