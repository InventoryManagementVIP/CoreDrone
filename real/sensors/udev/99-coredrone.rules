# Stable device names for the CoreDrone Jetson (parts: real/BOM.md). UNTESTED on hardware.
# Installed by real/jetson/setup.sh.

# Luxonis OAK cameras: accessible without root
SUBSYSTEM=="usb", ATTRS{idVendor}=="03e7", MODE="0666", GROUP="plugdev"

# Pixhawk 6C over USB (hwdef/Pixhawk6C: USB 3162:0053): /dev/flight_controller
SUBSYSTEM=="tty", ATTRS{idVendor}=="3162", ATTRS{idProduct}=="0053", SYMLINK+="flight_controller", MODE="0660", GROUP="dialout"
