<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>inv_bringup</name>
  <version>0.1.0</version>
  <description>
    Top-level launch (drone.launch.py): composes every package; platform:=sim|real,
    localization:=..., mapping:=..., perception:=..., mission:=... select the configuration.
  </description>
  <maintainer email="coredrone@example.com">CoreDrone team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>inv_description</exec_depend>
  <exec_depend>inv_flight_interface</exec_depend>
  <exec_depend>inv_inventory</exec_depend>
  <exec_depend>inv_layout</exec_depend>
  <exec_depend>inv_localization</exec_depend>
  <exec_depend>inv_mapping</exec_depend>
  <exec_depend>inv_mission</exec_depend>
  <exec_depend>inv_perception</exec_depend>
  <exec_depend>inv_safety</exec_depend>
  <exec_depend>inv_tools</exec_depend>
  <exec_depend>inv_uplink</exec_depend>
  <!-- Simulation platform (sim/launch/sim_platform.launch.py) -->
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
