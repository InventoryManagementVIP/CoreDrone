<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>inv_tools</name>
  <version>0.1.0</version>
  <description>
    Developer and operations tools: EKF origin setter (GPS-denied flight), flight-controller
    parameter diff against the committed .parm files, MCAP recording profiles.
  </description>
  <maintainer email="coredrone@example.com">CoreDrone team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>inv_layout</exec_depend>
  <exec_depend>python3-pymavlink</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
