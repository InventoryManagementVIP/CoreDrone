<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>inv_inventory</name>
  <version>0.1.0</version>
  <description>
    Turns label detections into inventory items: classifies item vs location labels with the
    warehouse layout, attributes items to slots (label first, pose fallback), and queues scan
    records in SQLite for the uplink.
  </description>
  <maintainer email="coredrone@example.com">CoreDrone team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>inv_interfaces</exec_depend>
  <exec_depend>inv_layout</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>python3-jsonschema</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
