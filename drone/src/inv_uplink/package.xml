<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>inv_uplink</name>
  <version>0.1.0</version>
  <description>
    Store-and-forward uplink: syncs the inventory SQLite queue to the backend whenever the network
    allows (idempotent by scan_id), validates records against contracts/, exports CSV.
  </description>
  <maintainer email="coredrone@example.com">CoreDrone team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>inv_interfaces</exec_depend>
  <exec_depend>inv_inventory</exec_depend>
  <exec_depend>python3-jsonschema</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
