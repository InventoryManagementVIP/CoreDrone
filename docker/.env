# Build pins shared by `just`, `docker compose` and CI.
#
# This file is the single source of truth for ROS_DISTRO: every Dockerfile takes it as a
# build argument and every CI job reads it from here (cat docker/.env >> $GITHUB_ENV).
# Read docs/adr/0002-ros-distro.md before changing it.
#
# This file is committed and must never hold secrets. Backend credentials go in the
# repo-root .env (gitignored, see .env.example).

ROS_DISTRO=jazzy

# Published by .github/workflows/docker-publish.yml. Tags: <distro>, <distro>-<git sha>.
DEV_IMAGE=ghcr.io/inventorymanagementvip/coredrone-dev

# Isaac ROS images (NVIDIA GPU / Jetson only; never built in GitHub-hosted CI).
# Isaac ROS 4.6 = ROS 2 Jazzy + JetPack 7.2. NVIDIA does not publish a tag-to-release map;
# these are the NGC "Isaac ROS Dev Base" tags pushed the day after 4.6.0 (2026-08-19).
# UNVERIFIED: confirm with `isaac-ros activate` on real hardware, then pin by digest.
ISAAC_ROS_RELEASE=4.6
ISAAC_ROS_BASE_X86=nvcr.io/nvidia/isaac/ros:isaac_ros_c1a76866f0754322e3cbe60b628df8f6-amd64
ISAAC_ROS_BASE_JETSON=nvcr.io/nvidia/isaac/ros:isaac_ros_c1a76866f0754322e3cbe60b628df8f6-arm64-jetpack
