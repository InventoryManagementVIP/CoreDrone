extends: default

ignore: |
  sim/worlds/generated/
  runs/

rules:
  line-length:
    max: 140
  document-start: disable
  truthy:
    check-keys: false          # GitHub Actions uses `on:` as a key
  comments:
    min-spaces-from-content: 1
  braces:
    max-spaces-inside: 1
  indentation:
    spaces: 2
    indent-sequences: consistent
