# Copy to `.env` (gitignored) and fill in. Never commit real values.
# On the Jetson these go in /etc/coredrone/coredrone.env (root-only), loaded by systemd
# (real/jetson/systemd/coredrone.service).

# Drone -> backend uplink (inv_uplink, backend: http). Phase 2: the app team provides these.
# Use an insert-only key for the scan_records table, never the service-role key.
INV_BACKEND_URL=https://<project>.supabase.co/rest/v1/scan_records
INV_BACKEND_KEY=

# ROS 2 / DDS domain. Must equal DDS_DOMAIN_ID on the flight controller. Give every drone (and
# every developer on a shared network) its own value.
ROS_DOMAIN_ID=0
